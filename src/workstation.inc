    void importPatternMidi(){if(selected==MasterChannel)return;auto path=fileDialog(false,L"MIDI (*.mid;*.midi)\0*.mid;*.midi\0\0",L"mid",root/L"projects");if(path.empty())return;try{auto imported=readMidi(path);std::vector<Note>notes;for(auto&track:imported.tracks)for(auto&clip:track.clips)for(auto n:patternNotes(track,clip.pattern)){n.beat+=clip.beat;n.channel=track.midiChannel-1;if(n.beat<256){n.length=std::min(n.length,256-n.beat);notes.push_back(n);}}if(notes.size()>100000)throw std::runtime_error("MIDI contains too many notes for one pattern");history();auto&t=channel(selected);editNotes(t)=std::move(notes);double last=4;for(auto&n:editNotes(t))last=std::max(last,n.beat+n.length);double&length=t.activePattern?t.patterns[t.activePattern-1].length:t.patternLength;length=std::min(256.,std::ceil(last/4)*4);if(t.clips.empty())t.clips={{0,length,t.activePattern}};noteSelection.clear();selectedNote=-1;project.bars=std::max(project.bars,barsForEnd(length));changed();notify(L"MIDI импортирован в выбранный паттерн");}catch(const std::exception&e){error(e.what());}}
