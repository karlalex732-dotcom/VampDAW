    void loadDracula(){if(draculaLoaded)return;draculaLoaded=true;auto resource=FindResourceW(GetModuleHandleW(nullptr),MAKEINTRESOURCEW(220),RT_RCDATA);if(!resource)return;auto loaded=LoadResource(GetModuleHandleW(nullptr),resource);auto bytes=SizeofResource(GetModuleHandleW(nullptr),resource);auto memory=GlobalAlloc(GMEM_MOVEABLE,bytes);if(!memory)return;auto data=GlobalLock(memory);if(!data){GlobalFree(memory);return;}memcpy(data,LockResource(loaded),bytes);GlobalUnlock(memory);IStream*stream=nullptr;if(SUCCEEDED(CreateStreamOnHGlobal(memory,TRUE,&stream))){Bitmap source(stream);if(source.GetLastStatus()==Ok)draculaPortrait.reset(source.Clone(0,0,source.GetWidth(),source.GetHeight(),PixelFormat32bppARGB));stream->Release();}else GlobalFree(memory);}
