        p.text(L"V A M P D A W",{cx-260,cy+h/2+22,520,50},29,Color((BYTE)a,239,224,234),true,1);p.text(L"WELCOME TO THE NIGHT",{cx-240,cy+h/2+72,480,27},11,Color((BYTE)(a*.65),196,148,166),false,1);p.text(L"Нажми, чтобы продолжить",{cx-240,cy+h/2+106,480,22},10,Color((BYTE)(a*.4),192,162,178),false,1);
