    void locateProjectAudio(){auto items=missingProjectMedia(project);if(items.empty()){notify(ui::language?L"Все аудиофайлы проекта доступны":L"All project audio is available");return;}HMENU menu=CreatePopupMenu();for(size_t i=0;i<items.size();i++){auto name=wide(items[i].owner)+L" — "+(items[i].sample->path.empty()?(ui::language?L"путь не сохранён":L"path was not saved"):items[i].sample->path.filename().wstring());AppendMenuW(menu,MF_STRING,i+1,name.c_str());}POINT point{};GetCursorPos(&point);int id=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);if(id<1||id>(int)items.size())return;auto item=items[id-1];auto initial=item.sample->path.empty()?(soundRoots.empty()?root/L"User Sounds":soundRoots.front()):item.sample->path;auto file=fileDialog(false,L"Audio files\0*.wav;*.flac;*.mp3;*.ogg;*.aif;*.aiff;*.m4a\0All files\0*.*\0",L"wav",initial);if(file.empty())return;LoadingOperation loading(*this,ui::language?L"Поиск аудиофайла":L"Relinking audio",file.filename().wstring());auto sample=readAudio(file);history();relinkProjectMedia(project,item.sample,sample);changed();publish();notify((ui::language?L"Аудио найдено. Осталось: ":L"Audio relinked. Remaining: ")+number(missingProjectMedia(project).size()));}
    void notifyProjectAudio(){auto missing=missingProjectMedia(project);if(!missing.empty())notify((ui::language?L"Проект открыт. Недоступно аудиофайлов: ":L"Project opened. Unavailable audio files: ")+number(missing.size())+(ui::language?L". SESSION → Найти аудио проекта…":L". SESSION → Locate project audio…"));}
