    void startExport(){if(exportBusy)return;auto range=renderRange();if(exportRange==3&&range.second<=range.first){notify(L"Сначала выдели клипы в плейлисте");return;}if(exportRange==2&&project.loopEnd<=project.loopStart){notify(L"Сначала выдели диапазон на шкале времени");return;}auto extension=audioExtension(exportOptions.format);std::wstring filter=std::wstring(audioFormatName(exportOptions.format))+L" audio (*."+extension+L")";filter.push_back(0);filter+=L"*."+std::wstring(extension);filter.push_back(0);filter.push_back(0);auto file=fileDialog(true,filter.c_str(),extension,root/L"renders"/(wide(project.name)+L"."+extension));if(file.empty())return;try{LoadingOperation loading(*this,L"Preparing export");exportResume=engine.playing;engine.stop();engine.stopAudition();capturePluginStates();for(auto&chain:plugins)for(auto&plugin:chain)if(!plugin->prepare(exportOptions.rate))throw std::runtime_error("Plugin does not support the export sample rate");std::unique_ptr<RenderPlan>plan;if(exportRange==1){if(selected!=MasterChannel&&!plugins[selected].empty()&&plugins[selected][0]->araActive())throw std::runtime_error("Use Song or Selection export for an ARA audio track");if(selected==MasterChannel)throw std::runtime_error("Select an instrument track for pattern export");bool before=patternPreview;patternPreview=true;try{plan=buildPlan();}catch(...){patternPreview=before;throw;}patternPreview=before;exportOptions.startBeat=0;exportOptions.endBeat=plan->length;}else{plan=compile(project,plugins);exportOptions.startBeat=range.first;exportOptions.endBeat=range.second;}fs::create_directories(file.parent_path());if(exportWorker.joinable())exportWorker.join();exportError.clear();exportDone=false;exportControl.progress=0;exportControl.phase=0;exportControl.cancel=false;exportPath=file;exportStarted=GetTickCount64();exportBusy=true;exportSettingsOpen=false;auto shared=std::shared_ptr<RenderPlan>(plan.release());auto options=exportOptions;exportWorker=std::thread([this,shared,file,options]{CoInitializeEx(nullptr,COINIT_MULTITHREADED);try{renderAudio(*shared,file,options,&exportControl);}catch(const std::exception&e){exportError=e.what();}CoUninitialize();exportDone=true;});InvalidateRect(window,nullptr,FALSE);}catch(const std::exception&e){restoreAfterExport();error(e.what());}}
    void restoreAfterExport(){for(auto&chain:plugins)for(auto&plugin:chain)plugin->prepare(engine.rate.load());publish();if(engine.hostWindow)engine.start(desiredAudio);engine.playing=exportResume;}
    void finishExport(){if(!exportBusy||!exportDone)return;if(exportWorker.joinable())exportWorker.join();exportBusy=false;if(finishBounce()||finishFreeze())return;restoreAfterExport();if(exportError.empty())notify(L"Экспорт сохранён: "+exportPath.filename().wstring());else if(exportControl.cancel)notify(L"Рендер отменён; прежний файл сохранён");else error(exportError);InvalidateRect(window,nullptr,FALSE);}
