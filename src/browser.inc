    size_t importDawPluginFolders(bool restore=false){if(restore)seenAutoPluginRoots=Json::array();std::set<std::wstring>seen,existing;for(auto&value:seenAutoPluginRoots)if(value.is_string())seen.insert(pluginPathKey(wide(value.get<std::string>())));for(auto&root:pluginRoots)existing.insert(pluginPathKey(root));size_t count=0;for(auto&folder:discoverPluginFolders()){auto key=pluginPathKey(folder.path);if(seen.insert(key).second){seenAutoPluginRoots.push_back(utf8(folder.path.wstring()));if(existing.insert(key).second){pluginRoots.push_back(folder.path);count++;}}}if(count){folderSelected[1]=(int)pluginRoots.size()-1;folderScroll[1]=std::max(0,(int)pluginRoots.size()-folderVisible);}return count;}
