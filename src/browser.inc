    void previewSound(const std::shared_ptr<Sample>&sample,double start=0,double end=-1){if(!sample||engine.state!=1)return;engine.stopAudition();Project preview;preview.tracks.resize(1);preview.loop=false;preview.bpm=120;preview.master.volume=.65f;preview.tracks[0].volume=.85f;preview.tracks[0].sample=sample;double duration=sample->left.size()/double(sample->rate);start=clamp(start,0,duration);end=end<0?std::min(duration,start+30):clamp(end,start,duration);if(end<=start)return;preview.tracks[0].clips={{0,(end-start)*2,0,start}};preview.bars=barsForEnd((end-start)*2);auto plan=compile(preview);plan->length=(end-start)*2;engine.audition(std::move(plan));}
    void browserChoose(int index,bool load){if(index<0||index>=(int)browserEntries.size())return;browserSelected=index;auto entry=browserEntries[index];if(entry.folder){if(load){browserPath=entry.path;refreshBrowser();}return;}if(browserTab==0){try{if(load)importAudioFile(entry.path,true);else if(browserAutoPreview){LoadingOperation loading(*this,L"Loading preview",entry.path.filename().wstring());previewSound(readAudio(entry.path));}}catch(const std::exception&e){error(e.what());}}else if(load){if(selected==MasterChannel&&entry.instrument){history();appendTrack(project);select((int)project.tracks.size()-1);}loadPlugin(entry.path);}}
    void beginCatalog(){LoadingOperation loading(*this,L"Finding plugins");if(!catalogDone){notify(L"A plugin scan is already running");return;}if(catalogWorker.joinable())catalogWorker.join();importDawPluginFolders();saveSettings();std::vector<fs::path>roots=pluginRoots;for(auto&path:paths.pluginDirectories())roots.push_back(path);catalog.clear();catalogScanned=0;catalogTotal=0;catalogDone=false;catalogCancel=false;wchar_t binary[32768]{};GetModuleFileNameW(nullptr,binary,32768);auto host=fs::path(binary),directory=stateRoot,bundled=paths.binaries/L"plugins";fs::create_directories(stateRoot/L"work/catalog");catalogWorker=std::thread([this,roots,host,directory,bundled]{std::vector<fs::path>files;try{files=findPlugins(roots);}catch(...){catalogDone=true;PostMessageW(window,WM_APP+8,0,0);return;}catalogTotal=(int)files.size();for(size_t i=0;i<files.size()&&!catalogCancel;i++){auto output=directory/L"work/catalog"/(std::to_wstring(GetCurrentProcessId())+L"-"+std::to_wstring(i)+L".json");std::wstring command=L"\""+host.wstring()+L"\" --catalog \""+files[i].wstring()+L"\" \""+output.wstring()+L"\"";STARTUPINFOW startup{sizeof startup};startup.dwFlags=STARTF_USESHOWWINDOW;startup.wShowWindow=SW_HIDE;PROCESS_INFORMATION process{};Json result={{"path",utf8(files[i].wstring())},{"ok",false},{"name",utf8(files[i].stem().wstring())}};
                if(CreateProcessW(host.c_str(),command.data(),nullptr,nullptr,FALSE,CREATE_NO_WINDOW,nullptr,directory.c_str(),&startup,&process)){DWORD wait=WAIT_TIMEOUT;for(int elapsed=0;elapsed<15000&&!catalogCancel;elapsed+=100){wait=WaitForSingleObject(process.hProcess,100);if(wait!=WAIT_TIMEOUT)break;}if(wait==WAIT_TIMEOUT){TerminateProcess(process.hProcess,1);WaitForSingleObject(process.hProcess,1000);result["error"]="scan timeout";}else{DWORD exit=1;GetExitCodeProcess(process.hProcess,&exit);try{std::ifstream f(output);if(f)f>>result;else result["error"]="plugin scanner exited without a result";}catch(...){result["error"]="invalid scan result";}result["exitCode"]=exit;}CloseHandle(process.hThread);CloseHandle(process.hProcess);}std::error_code ec;fs::remove(output,ec);result["vamp"]=files[i].wstring().find(bundled.wstring()+L"\\")==0;auto data=result.dump();while(!catalogCancel&&!catalogResults.push(data))Sleep(10);PostMessageW(window,WM_APP+8,0,0);}catalogDone=true;PostMessageW(window,WM_APP+8,0,0);});}
    void drainCatalog(){std::string item;bool updated=false;while(catalogResults.pop(item)){try{catalog.push_back(Json::parse(item));catalogScanned++;updated=true;}catch(...){}}if(updated){refreshBrowser();if(pluginPickerWindow)refreshPluginPicker();}if(catalogDone&&catalogWorker.joinable()){catalogWorker.join();std::ofstream(stateRoot/L"plugin-catalog.json")<<catalog.dump(2);}}
