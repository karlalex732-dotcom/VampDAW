    static std::wstring lower(std::wstring s){std::transform(s.begin(),s.end(),s.begin(),[](wchar_t c){return (wchar_t)towlower(c);});return s;}
    void refreshBrowser(){browserEntries.clear();browserSelected=-1;browserScroll=0;if(browserTab==0){if(soundRoots.empty()){InvalidateRect(window,nullptr,FALSE);return;}browserRoot=(int)clamp(browserRoot,0,soundRoots.size()-1);if(browserPath.empty())browserPath=soundRoots[browserRoot];std::error_code ec;for(fs::directory_iterator i(browserPath,fs::directory_options::skip_permission_denied,ec),end;i!=end&&!ec;i.increment(ec)){bool folder=i->is_directory(ec);auto ext=lower(i->path().extension().wstring());if(!folder&&ext!=L".wav"&&ext!=L".flac"&&ext!=L".mp3")continue;auto name=i->path().filename().wstring();if(!browserSearch.empty()&&lower(name).find(lower(browserSearch))==std::wstring::npos)continue;browserEntries.push_back({i->path(),name,folder,false});if(browserEntries.size()>=10000)break;}}
