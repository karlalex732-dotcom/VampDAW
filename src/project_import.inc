    ProjectImporter projectImporter;fs::path lastImportReport;
    void importForeignProject(const fs::path&source){if(projectImporter.busy){notify(L"A project import is already running. Esc cancels it.");return;}if(exportBusy||audioRecording||recording){notify(L"Stop recording or rendering before importing a project");return;}if(!ensureSaved())return;try{auto tools=paths.binaries/L"tools";auto directory=root/L"projects/Imported"/(std::to_wstring(GetCurrentProcessId())+L"-"+std::to_wstring(GetTickCount64()));projectImporter.start(tools/L"stems/python/python.exe",tools/L"project-import/import_project.py",audioEncoderPath(),fs::absolute(source),directory,window);notify(L"Importing project. Esc cancels. The original file stays unchanged.");}catch(const std::exception&e){error(e.what());}}
    void finishForeignProject(){if(!projectImporter.done)return;auto result=projectImporter.result();if(!result.value("passed",false)){if(!result.value("cancelled",false))error(result.value("error","Project import failed"));else notify(L"Project import cancelled");return;}try{LoadingOperation loading(*this,L"Loading imported project");auto file=fs::path(wide(result.at("project").get<std::string>()));auto loaded=loadProject(file);compile(loaded);if(!ensureSaved())return;finishMidiRecording();finishAudioRecording();++importGeneration;engine.stop();engine.beat=0;patternPreview=false;project=std::move(loaded);playlistRowOffset=projectTreeScroll=0;mixerPeakHold.fill(0);projectTreeFolder=-1;projectPath.clear();syncPlugins();undoStack.clear();redoStack.clear();select(0);modified=true;lastImportReport=projectImporter.directory/L"Import Report.txt";auto warnings=result.value("warnings",Json::array());notify(L"Project imported. Choose instruments for MIDI tracks; review the import report.");auto text=ui::translate(L"Import complete. Original file unchanged.")+L"\n"+ui::translate(L"Tracks")+L": "+number(result.value("tracks",0))+L"\n"+ui::translate(L"Items to review")+L": "+number(warnings.size())+L"\n\n"+ui::translate(L"Devices, plugin states, automation and warping need manual review.")+L"\n\n"+ui::translate(L"Report")+L": "+lastImportReport.wstring();MessageBoxW(window,text.c_str(),L"VampDAW / Project import",MB_OK|MB_ICONINFORMATION);InvalidateRect(window,nullptr,FALSE);}catch(const std::exception&e){error(e.what());}}
    void chooseForeignProject(){auto path=fileDialog(false,L"Projects (*.flp;*.als)\0*.flp;*.als\0\0",L"als",root/L"projects");if(!path.empty())importForeignProject(path);}
