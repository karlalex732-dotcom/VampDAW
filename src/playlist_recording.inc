    bool usingAsio()const{return desiredAudio.rfind(L"asio:",0)==0;}
    int inputTrack()const{if(audioRecordTrack>=0)return audioRecordTrack;for(int i=0;i<(int)project.tracks.size();i++)if(project.tracks[i].armed)return i;for(int i=0;i<(int)project.tracks.size();i++)if(project.tracks[i].monitor)return i;if(engine.recall.enabled&&recallTrack>=0&&recallTrack<(int)project.tracks.size())return recallTrack;return -1;}
    std::wstring inputLabel(const Track&t)const{int base=usingAsio()?t.asioInputPair:t.inputPair*2;return t.inputMode==0?L"Input "+number(base+1)+L" / "+number(base+2)+L" · Stereo":L"Input "+number(base+t.inputMode)+L" · Mono";}
    AudioCapture&sourceCapture(int pair){return pair>0?engine.extraCapture[pair-1]:engine.capture;}
    void mapActiveCaptureDevices(){if(usingAsio())return;std::wstring primary;for(int i=0;i<(int)project.tracks.size();i++){auto&t=project.tracks[i];if(t.audioInput&&t.inputPair==0&&(t.armed||t.monitor||i==recallTrack)){primary=t.inputDevice.empty()?desiredCapture:wide(t.inputDevice);if(primary.empty())primary=defaultAudioId(true);break;}}
        for(int i=0;i<(int)project.tracks.size();i++){auto&t=project.tracks[i];if(!t.audioInput||t.inputPair!=0||(!t.armed&&!t.monitor&&i!=recallTrack))continue;auto device=t.inputDevice.empty()?desiredCapture:wide(t.inputDevice);if(device.empty())device=defaultAudioId(true);if(device==primary)continue;int slot=-1;for(int n=0;n<3;n++)if(engine.aggregateInputIds[n]==device)slot=n;if(slot<0)for(int n=0;n<3;n++)if(engine.aggregateInputIds[n].empty()){slot=n;break;}if(slot<0)throw std::runtime_error("Use up to four WASAPI input devices; free an Aggregate Input slot first");engine.aggregateEnabled=true;engine.aggregateInputIds[slot]=device;t.inputPair=slot+1;t.inputDevice.clear();}
