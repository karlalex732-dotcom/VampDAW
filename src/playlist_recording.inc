    void startCapture(const fs::path&unused={}){
        int index=inputTrack();const Track*t=index>=0?&project.tracks[index]:nullptr;if(!usingAsio())for(int i=0;i<(int)project.tracks.size();i++){auto&track=project.tracks[i];if(track.audioInput&&track.inputPair==0&&(track.armed||track.monitor||i==recallTrack)){t=&track;break;}}
        if(usingAsio()){if(t&&engine.asioInput<0)engine.asioInput=t->asioInputPair;engine.capture.startExternal(engine.rate.load());return;}
        if(t&&t->inputPair>0&&(!engine.aggregateEnabled||engine.aggregateInputIds[t->inputPair-1].empty()))throw std::runtime_error("Configure the selected aggregate input first");
        auto device=t&&!t->inputDevice.empty()?wide(t->inputDevice):desiredCapture;
        if(!device.empty()){auto ports=audioPorts(true);if(std::none_of(ports.begin(),ports.end(),[&](auto&p){return p.id==device;}))throw std::runtime_error("The track input device is disconnected. Choose Audio Input again.");}
        engine.capture.start(device,engine.rate.load());
        if(engine.aggregateEnabled)for(int i=0;i<3;i++)if(!engine.aggregateInputIds[i].empty())engine.extraCapture[i].start(engine.aggregateInputIds[i],engine.rate.load());
    }
    void restartInput(){if(audioRecording||!engine.hostWindow)return;bool playing=engine.playing;engine.stop();stopCaptures();try{mapActiveCaptureDevices();if(inputTrack()>=0)startCapture();}catch(const std::exception&e){notify(wide(e.what()));}engine.start(desiredAudio);engine.playing=playing;}
    void trackInputMenu(int index){if(index!=MasterChannel&&channel(index).frozen){notify(L"Unfreeze the track before recording or monitoring");return;}
        if(index==MasterChannel)return;if(audioRecording){notify(L"Заверши дубль перед сменой входа");return;}
        struct Choice{int pair,mode,asio;std::string device;};std::vector<Choice>choices;HMENU menu=CreatePopupMenu();auto&t=channel(index);
        auto add=[&](HMENU group,const std::wstring&name,int pair,int mode,int asio,const std::string&device){choices.push_back({pair,mode,asio,device});bool current=t.audioInput&&t.inputPair==pair&&t.inputMode==mode&&(usingAsio()?t.asioInputPair==asio:t.inputDevice==device);AppendMenuW(group,MF_STRING|(current?MF_CHECKED:0),1000+choices.size(),name.c_str());};
        if(usingAsio()){
            int count=std::min(64,engine.asioInputs.load());for(int i=0;i<count;i+=2){HMENU group=CreatePopupMenu();if(i+1<count)add(group,L"Stereo "+number(i+1)+L" / "+number(i+2),0,0,i,{});add(group,L"Mono input "+number(i+1),0,1,i,{});if(i+1<count)add(group,L"Mono input "+number(i+2),0,2,i,{});AppendMenuW(menu,MF_POPUP,(UINT_PTR)group,(L"ASIO inputs "+number(i+1)+(i+1<count?L" / "+number(i+2):L"")).c_str());}
            if(!count)AppendMenuW(menu,MF_STRING|MF_GRAYED,0,L"No ASIO inputs — select an audio interface in USB / MIDI");
        }else{
            auto deviceMenu=[&](const std::wstring&label,const std::string&device,int pair){HMENU group=CreatePopupMenu();add(group,L"Mono input 1 / Left",pair,1,0,device);add(group,L"Mono input 2 / Right",pair,2,0,device);add(group,L"Stereo inputs 1 / 2",pair,0,0,device);AppendMenuW(menu,MF_POPUP,(UINT_PTR)group,label.c_str());};
            deviceMenu(L"Configured input / USB · MIDI",{},0);for(auto&p:audioPorts(true))deviceMenu(p.name,utf8(p.id),0);
            if(engine.aggregateEnabled)for(int i=0;i<3;i++)if(!engine.aggregateInputIds[i].empty())deviceMenu(L"Aggregate input "+number(i*2+3)+L" / "+number(i*2+4),{},i+1);
        }
        AppendMenuW(menu,MF_SEPARATOR,0,nullptr);AppendMenuW(menu,MF_STRING,1,L"Audio device settings…");POINT point;GetCursorPos(&point);int id=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);if(id==1){devices();return;}if(id<1001||id>1000+(int)choices.size())return;
        if(!plugins[index].empty()&&plugins[index][0]->instrument())editPlugin({RemovePlugin,{},index,0});
        history();auto&track=channel(index);track.audioInput=true;track.external=false;
        if(track.sample&&!track.sampler)for(auto&clip:track.clips)if(!clip.audio)clip.audio=track.sample;
        track.sampler=false;auto choice=choices[id-1001];track.inputPair=choice.pair;track.inputMode=choice.mode;track.asioInputPair=choice.asio;track.inputDevice=choice.device;
        
        select(index);changed();publish();restartInput();notify(L"Audio Input: "+inputLabel(track)+L". REC на дорожке → ● в Playlist. MON — слушать вход.");
    }
    void armAudio(int index){if(index!=MasterChannel&&channel(index).frozen){notify(L"Unfreeze the track before recording or monitoring");return;}if(index==MasterChannel)return;if(audioRecording){notify(L"Заверши текущий дубль кнопкой ● или ■");return;}if(!channel(index).audioInput){trackInputMenu(index);if(!channel(index).audioInput)return;}history();bool enabled=!channel(index).armed;channel(index).armed=enabled;select(index);changed();publish();restartInput();notify(enabled?L"REC: канал готов. Поставь курсор в Playlist и нажми ● сверху.":L"Готовность канала к записи выключена");}
    void monitorAudio(int index){if(index!=MasterChannel&&channel(index).frozen){notify(L"Unfreeze the track before recording or monitoring");return;}if(index==MasterChannel)return;if(!channel(index).audioInput){trackInputMenu(index);if(!channel(index).audioInput)return;}history();bool enabled=!channel(index).monitor;channel(index).monitor=enabled;changed();publish();restartInput();notify(enabled?L"MON: вход прослушивается через эффекты канала":L"Мониторинг выключен");}
    void beginAudioRecording(int index){
        if(engine.state!=1||sampleBusy){notify(L"Choose a ready audio device before recording");return;}std::vector<int>tracks;for(int i=0;i<(int)project.tracks.size();i++)if(project.tracks[i].armed&&project.tracks[i].audioInput&&!project.tracks[i].frozen)tracks.push_back(i);if(tracks.empty())return;if(tracks.size()>32){notify(L"Arm up to 32 audio tracks per take");return;}
        try{std::string primary;for(int id:tracks){auto&t=project.tracks[id];if(usingAsio()){if(t.asioInputPair>=std::min(64,engine.asioInputs.load())||(t.inputMode!=1&&t.asioInputPair+1>=std::min(64,engine.asioInputs.load())))throw std::runtime_error("An armed ASIO input is unavailable");}else{if(sourceCapture(t.inputPair).state!=1)throw std::runtime_error("An armed input device is not ready");if(t.inputPair==0){auto device=t.inputDevice.empty()?utf8(desiredCapture.empty()?defaultAudioId(true):desiredCapture):t.inputDevice;if(!primary.empty()&&primary!=device)throw std::runtime_error("Assign other devices to separate Aggregate Input slots first");primary=device;}}}
            bool wasPlaying=engine.playing;audioRecordBeat=engine.beat.load();engine.stop();engine.multiRecorders.clear();audioRecordTrack=tracks.front();patternPreview=false;mode=0;select(audioRecordTrack);
            fs::create_directories(root/L"projects/assets");for(int id:tracks){auto&t=project.tracks[id];auto take=std::make_unique<Engine::MultiRecording>();take->track=id;take->pair=t.inputPair;take->mode=t.inputMode;take->asio=t.asioInputPair;take->path=root/L"projects/assets"/(L"Take-"+number(GetCurrentProcessId())+L"-"+number(GetTickCount64())+L"-"+number(id+1)+L".wav");take->capture->startExternal(engine.rate.load(),take->path,t.inputMode==0?2:1);engine.multiRecorders.push_back(std::move(take));}
            engine.recordPair=usingAsio()?0:project.tracks[audioRecordTrack].inputPair;audioRecording=recording=true;publish();engine.beat=audioRecordBeat;engine.start(desiredAudio);auto meter=songClock(project).meterAt(audioRecordBeat);double count=countInMidi&&!wasPlaying?countInBars*meter.numerator*4./meter.denominator:0;engine.countInRemaining=count;engine.countInRequest=count?count:-1;engine.recordInput=true;engine.playing=true;notify(L"Recording armed inputs to separate Playlist tracks");
        }catch(const std::exception&e){engine.recordInput=false;engine.stop();audioRecording=recording=false;for(auto&take:engine.multiRecorders)take->capture->stop();engine.multiRecorders.clear();audioRecordTrack=-1;publish();restartInput();error(e.what());}
    }
    void finishAudioRecording(){
        if(!audioRecording)return;engine.recordInput=false;engine.stop();audioRecording=recording=false;for(auto&take:engine.multiRecorders)take->capture->stop();bool saved=false;int errors=0;unsigned gaps=0;
        for(auto&take:engine.multiRecorders){gaps+=take->capture->droppedPackets.load();if(!take->capture->recordedFrames)continue;try{auto sample=readWav(take->path);if(take->track<0||take->track>=(int)project.tracks.size())continue;if(!saved){history();saved=true;}auto&t=project.tracks[take->track];double duration=sample->left.size()/double(sample->rate),latency=(engine.latencyMs.load()+(usingAsio()?engine.inputLatencyMs.load():sourceCapture(t.inputPair).latencyMs.load()+1000./30))/1000.;Clip clip;clip.beat=audioRecordBeat;clip.offset=latency<duration*.5?latency:0;clip.length=songClock(project).beat(songClock(project).seconds(clip.beat)+duration-clip.offset)-clip.beat;clip.name=t.name+" / Take "+std::to_string(t.clips.size()+1);clip.audio=sample;t.clips.push_back(clip);project.bars=std::min(4096,std::max(project.bars,barsForEnd(clip.beat+clip.length)));}catch(...){errors++;}}
