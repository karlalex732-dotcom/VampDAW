    }
    void liveRecordingClip(Painter&p,int track,float y,float unit,float trackHeight){
        if(!audioRecording)return;auto found=std::find_if(engine.multiRecorders.begin(),engine.multiRecorders.end(),[&](auto&t){return t->track==track;});if(found==engine.multiRecorders.end())return;auto&rec=*(*found)->capture;if(engine.countInRemaining>0){float x=arrangement.x+(float)(audioRecordBeat-viewStart)*unit;p.fill({x,y+3,130,trackHeight-6},alpha(crimson,75),3);p.text(L"COUNT-IN / "+number(std::ceil(engine.countInRemaining.load())),{x+4,y+3,122,trackHeight-6},9,textColor,true);return;}double duration=rec.recordedFrames.load()/engine.rate.load();float x=arrangement.x+(float)(audioRecordBeat-viewStart)*unit,w=std::max(3.f,(float)(songClock(project).beat(songClock(project).seconds(audioRecordBeat)+duration)-audioRecordBeat)*unit);Rect rect{x+1,y+3,w-2,trackHeight-6};p.fill(rect,alpha(crimson,80),3);p.line(rect.x,rect.y,rect.x+rect.w,rect.y,crimson,2);
        auto count=rec.peakHistoryCount.load(std::memory_order_acquire);auto first=count>rec.peakHistory.size()?count-rec.peakHistory.size():0;for(auto n=first;n<count;n++){float xx=x+(float)(rec.peakHistoryFrame[n%rec.peakHistory.size()].load()/std::max(1.,duration*engine.rate.load()))*w;float peak=rec.peakHistory[n%rec.peakHistory.size()].load();float a=std::min(1.f,peak)*std::max(1.f,(rect.h-4)*.5f);p.line(xx,rect.y+rect.h*.5f-a,xx,rect.y+rect.h*.5f+a,crimson);}
