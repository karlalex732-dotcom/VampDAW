    void addMarker(){auto name=TextPrompt::show(window,L"Маркер секции песни",L"Verse");if(!name||name->empty())return;if(project.markers.size()>=256){notify(L"Максимум 256 маркеров");return;}history();project.markers.push_back({editCursorBeat,utf8(*name),(int)project.markers.size()%5});std::sort(project.markers.begin(),project.markers.end(),[](auto&a,auto&b){return a.beat<b.beat;});changed();}
    void loopSelected(){double first=project.bars*4.,last=0;for(auto&index:clipSelection)if(index.first<(int)project.tracks.size()&&index.second<(int)project.tracks[index.first].clips.size()){auto&c=project.tracks[index.first].clips[index.second];first=std::min(first,c.beat);last=std::max(last,c.beat+c.length);}if(last<=first){if(auto*c=editingClip()){first=c->beat;last=c->beat+c->length;}else return;}history();project.loopStart=first;project.loopEnd=std::min(project.bars*4.,last);project.loop=true;changed();}
