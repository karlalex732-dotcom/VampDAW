    void workflowMenu(){HMENU menu=CreatePopupMenu();AppendMenuW(menu,MF_STRING,1,L"Make selected pattern clip unique");AppendMenuW(menu,MF_STRING,2,L"Split all clips at playhead");AppendMenuW(menu,MF_STRING,3,L"Insert empty time at loop range (all tracks)");AppendMenuW(menu,MF_STRING,4,L"Delete loop time and close gap (all tracks)");AppendMenuW(menu,MF_STRING,5,L"Select all clips of this pattern");AppendMenuW(menu,MF_STRING,6,L"Fit song in playlist");POINT point;GetCursorPos(&point);int id=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);if(!id)return;try{if(id==6){viewStart=0;visibleBars=project.bars;InvalidateRect(window,nullptr,FALSE);return;}if(id==5){if(selected==MasterChannel||!editingClip())return;int pattern=editingClip()->pattern;clipSelection.clear();for(int i=0;i<(int)channel(selected).clips.size();i++)if(channel(selected).clips[i].pattern==pattern)clipSelection.insert({selected,i});InvalidateRect(window,nullptr,FALSE);return;}if((id==3||id==4)&&project.loopEnd<=project.loopStart)throw std::runtime_error("Select a loop range on the playlist ruler first");if(id==1&&(selected==MasterChannel||!editingClip()))throw std::runtime_error("Select a pattern clip first");Project next=project;if(id==1)makePatternUnique(next,selected,selectedClip);if(id==2)splitArrangementAt(next,engine.beat.load());if(id==3||id==4)spliceArrangementTime(next,project.loopStart,project.loopEnd-project.loopStart,id==4);history();project=std::move(next);clipSelection.clear();selectedClip=-1;changed();notify(L"Готово. Ctrl+Z — отменить изменение аранжировки.");}catch(const std::exception&e){error(e.what());}}
