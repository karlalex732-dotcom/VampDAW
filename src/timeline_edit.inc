namespace vamp {
void makePatternUnique(Project&p,int track,int clip){auto&t=p.tracks.at(track);auto&c=t.clips.at(clip);if(clipAudio(t,c))throw std::runtime_error("This clip is audio");if(t.patterns.size()>=255)throw std::runtime_error("Maximum 256 patterns");Pattern pattern;pattern.name="Unique "+std::to_string(t.patterns.size()+2);pattern.length=patternLength(t,c.pattern);pattern.notes=patternNotes(t,c.pattern);t.patterns.push_back(std::move(pattern));c.pattern=(int)t.patterns.size();t.activePattern=c.pattern;}
static Clip trimClip(const Track&t,const Clip&c,double from,double to,double bpm){Clip out=c;double offset=from-c.beat;out.beat=from;out.length=to-from;if(clipAudio(t,c))out.offset+=offset*60/bpm;else out.patternOffset=std::fmod(c.patternOffset+offset,patternLength(t,c.pattern));if(offset>1e-8)out.fadeIn=0;if(to<c.beat+c.length-1e-8)out.fadeOut=0;out.fadeIn=std::min(out.fadeIn,out.length);out.fadeOut=std::min(out.fadeOut,out.length);return out;}
void splitArrangementAt(Project&p,double beat){if(!std::isfinite(beat)||beat<0||beat>16384)throw std::runtime_error("Invalid split position");Project next=p;for(auto&t:next.tracks){std::vector<Clip>clips;for(auto&c:t.clips){double end=c.beat+c.length;if(c.beat<beat-1e-8&&end>beat+1e-8){clips.push_back(trimClip(t,c,c.beat,beat,p.bpm));clips.push_back(trimClip(t,c,beat,end,p.bpm));}else clips.push_back(c);}if(clips.size()>4096)throw std::runtime_error("Maximum 4096 clips per track");t.clips=std::move(clips);}p=std::move(next);}
void spliceArrangementTime(Project&p,double first,double length,bool remove){if(!std::isfinite(first)||!std::isfinite(length)||first<0||length<=0||first+length>16384)throw std::runtime_error("Invalid time range");if(!remove&&p.bars*4.+length>16384)throw std::runtime_error("Arrangement would exceed 4096 bars");Project next=p;double last=first+length;
    auto points=[&](std::vector<Point>&lane){if(lane.empty())return;float before=automationAt(lane,first),after=automationAt(lane,last);std::vector<Point>result;for(auto point:lane){if(remove){if(point.beat>=first&&point.beat<last)continue;if(point.beat>=last)point.beat-=length;}else if(point.beat>=first)point.beat+=length;result.push_back(point);}if(remove)result.push_back({first,after});else{result.push_back({first,before});result.push_back({last,before});}std::stable_sort(result.begin(),result.end(),[](auto&a,auto&b){return a.beat<b.beat;});std::vector<Point>unique;for(auto&point:result){if(!unique.empty()&&std::abs(unique.back().beat-point.beat)<1e-8)unique.back()=point;else unique.push_back(point);}lane=std::move(unique);};
    for(auto&t:next.tracks){std::vector<Clip>clips;for(auto&c:t.clips){double end=c.beat+c.length;if(remove){if(c.beat<first){auto left=trimClip(t,c,c.beat,std::min(first,end),p.bpm);if(left.length>1e-8)clips.push_back(left);}if(end>last){auto right=trimClip(t,c,std::max(c.beat,last),end,p.bpm);right.beat-=length;clips.push_back(right);}}else if(c.beat>=first){auto copy=c;copy.beat+=length;clips.push_back(copy);}else if(end>first){clips.push_back(trimClip(t,c,c.beat,first,p.bpm));auto right=trimClip(t,c,first,end,p.bpm);right.beat+=length;clips.push_back(right);}else clips.push_back(c);}if(clips.size()>4096)throw std::runtime_error("Maximum 4096 clips per track");t.clips=std::move(clips);points(t.automation);for(auto&lane:t.automationLanes)points(lane.points);}
    points(next.master.automation);for(auto&lane:next.master.automationLanes)points(lane.points);next.markers.erase(std::remove_if(next.markers.begin(),next.markers.end(),[&](auto&m){return remove&&m.beat>=first&&m.beat<last;}),next.markers.end());for(auto&m:next.markers)if(m.beat>=(remove?last:first))m.beat+=remove?-length:length;next.bars=barsForEnd(std::max(4.,p.bars*4.+(remove?-length:length)));next.loopStart=first;next.loopEnd=remove?first:first+length;p=std::move(next);
}

