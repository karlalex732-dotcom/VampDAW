    void instrumentSlotMenu(){if(frozenSource())return;if(selected==MasterChannel)return;HMENU menu=CreatePopupMenu();AppendMenuW(menu,MF_STRING,1,L"Выбрать сэмпл… / WAV, FLAC, MP3");AppendMenuW(menu,MF_STRING,2,L"Выбрать VST Instrument…");AppendMenuW(menu,MF_STRING,5,L"Audio Input… / guitar, synth, microphone");if(!plugins[selected].empty()&&plugins[selected][0]->instrument())AppendMenuW(menu,MF_STRING,7,pluginIsStarred(favoritePlugins,utf8(plugins[selected][0]->path.wstring()))?L"Remove from Starred":L"Add to Starred");if(channel(selected).sample){AppendMenuW(menu,MF_STRING,3,L"Открыть Sample Lab");AppendMenuW(menu,MF_STRING,4,L"Играть сэмпл по нотам / Chromatic");}POINT point;GetCursorPos(&point);int id=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);if(id==1){auto file=fileDialog(false,L"Audio (*.wav;*.flac;*.mp3)\0*.wav;*.flac;*.mp3\0\0",L"wav",root/L"User Sounds");if(!file.empty())try{loadSampleInstrument(file);}catch(const std::exception&e){error(e.what());}}if(id==2){openPluginPicker(true);}if(id==7){auto plug=plugins[selected][0];changePluginStar({{"path",utf8(plug->path.wstring())},{"name",plug->info.name},{"instrument",true},{"vamp",false}});}if(id==5)trackInputMenu(selected);if(id==3)showEditor(4);if(id==4){history();auto&t=channel(selected);t.sampler=true;t.chromatic=true;t.rootNote=60;t.oneShot=false;t.slices={{0,t.sample->left.size()/double(t.sample->rate)}};changed();}InvalidateRect(window,nullptr,FALSE);}
    void loadSampleInstrument(const fs::path&path){if(frozenSource())return;if(sampleBusy)throw std::runtime_error("Wait for audio processing to finish");LoadingOperation loading(*this,L"Loading sample",path.filename().wstring());auto sample=readAudio(path);if(sample->left.empty())throw std::runtime_error("Sample is empty");finishMidiRecording();finishAudioRecording();bool playing=engine.playing;engine.stop();engine.stopAudition();try{capturePluginStates();if(selected==MasterChannel||(channel(selected).sample&&!channel(selected).sampler&&!channel(selected).clips.empty())){if(project.tracks.size()>=TrackCount)throw std::runtime_error("Create an empty instrument track first");history();appendTrack(project);select((int)project.tracks.size()-1);}else history();fs::create_directories(root/L"projects/assets");auto destination=root/L"projects/assets"/(L"Sampler-"+number(GetTickCount64())+L"-"+number(++sampleGeneration)+L".wav");WaveWriter writer(destination,sample->rate);for(size_t at=0;at<sample->left.size();at+=MaxBlock)writer.write(sample->left.data()+at,sample->right.data()+at,(int)std::min<size_t>(MaxBlock,sample->left.size()-at));writer.finish();sample->path=destination;auto&t=channel(selected);auto&chain=plugins[selected];if(!chain.empty()&&chain[0]->instrument()){chain.erase(chain.begin());t.pluginPaths.erase(t.pluginPaths.begin());if(!t.pluginStates.empty())t.pluginStates.erase(t.pluginStates.begin());if(!t.pluginBypass.empty())t.pluginBypass.erase(t.pluginBypass.begin());if(t.automationTarget==2){if(t.automationSlot==0)t.automationEnabled=false;else if(t.automationSlot>0)t.automationSlot--;}t.automationLanes.erase(std::remove_if(t.automationLanes.begin(),t.automationLanes.end(),[](auto&lane){return lane.target==2&&lane.slot==0;}),t.automationLanes.end());for(auto&lane:t.automationLanes)if(lane.target==2&&lane.slot>0)lane.slot--;}
            t.audioInput=false;t.armed=false;t.monitor=false;t.sample=std::move(sample);t.sampler=true;t.chromatic=true;t.oneShot=false;t.rootNote=60;t.external=false;t.slices={{0,t.sample->left.size()/double(t.sample->rate)}};t.name=utf8(path.stem().wstring());t.sampleBpm=0;t.sampleKey.clear();slotOffset=0;audioStart=audioSpan=audioSelectA=audioSelectB=0;publish();changed();notify(L"Сэмпл в слоте инструмента. F7 — ноты, F6 — шаги. C5 — исходная высота.");engine.start(desiredAudio);engine.playing=playing;}catch(...){engine.start(desiredAudio);engine.playing=playing;throw;}}
    void dropFile(const fs::path&path,float x,float y){if(generatorOpen){if(generatorTab==0)for(auto h:hits)if(h.action==GeneratorCommand&&h.index>=100&&h.index<108&&h.rect.contains(x,y)){try{LoadingOperation loading(*this,L"Loading drum sample",path.filename().wstring());auto sample=readAudio(path);if(!sample||sample->left.empty())throw std::runtime_error("Empty audio sample");generatorLanes[h.index-100]={-1,sample};rebuildGenerator();}catch(const std::exception&e){generatorError=wide(e.what());InvalidateRect(window,nullptr,FALSE);}break;}return;}if(exportBusy||exportSettingsOpen||settingsOpen){notify(L"Закрой окно настроек перед переносом файла");return;}try{bool instrument=selected!=MasterChannel&&instrumentDrop.contains(x,y);int target=selected;for(auto&h:hits)if(h.rect.contains(x,y)&&(h.action==Select||h.action==PluginSlot||h.action==InstrumentSlot))target=h.index;if(target==MasterChannel)select(MasterChannel);else if(target>=0&&target<(int)project.tracks.size()&&target!=selected)select(target);auto extension=lower(path.extension().wstring());if(extension==L".flp"||extension==L".als"){importForeignProject(path);return;}if(extension==L".dll"||extension==L".vst3"||extension==L".vampfx"){loadPlugin(path);return;}if(extension!=L".wav"&&extension!=L".flac"&&extension!=L".mp3")throw std::runtime_error("Drop WAV, FLAC, MP3, VST2 or VST3 here");if(instrument||mode==1||mode==2||mode==3){loadSampleInstrument(path);return;}double at=0;if(mode==0&&arrangement.contains(x,y)){int row=playlistTrackAtY(y);if(row<0){notify(L"Drop audio onto a track");return;}while(row>=(int)project.tracks.size()&&project.tracks.size()<TrackCount){history();appendTrack(project);}if(row<(int)project.tracks.size())select(row);at=quantize(viewStart+(x-arrangement.x)/arrangement.w*visibleBars*4);}importAudioFile(path,true,at);if(mode==4){audioStart=0;audioSpan=0;}}catch(const std::exception&e){error(e.what());}}
