    void setTempo(double bpm,bool coalesce=false){for(auto&track:project.tracks)if(track.frozen){notify(L"Unfreeze tracks before changing tempo");return;}finishAudioRecording();if(!std::isfinite(bpm))return;bpm=clamp(bpm,MinTempo,MaxTempo);if(std::abs(bpm-project.bpm)<1e-8)return;auto now=GetTickCount64();if(!coalesce||now-tempoEditTime>400)history();else{modified=true;redoStack.clear();}tempoEditTime=now;double beat=engine.beat.load();project.bpm=bpm;for(auto&point:project.tempoMap)if(point.beat==0)point.bpm=bpm;LoadingOperation loading(*this,L"Updating song tempo");changed();publish();engine.seek=beat;InvalidateRect(window,nullptr,FALSE);}
    void tempoPrompt(){auto text=TextPrompt::show(window,L"Темп — точное значение BPM (10–999)",number(project.bpm,3));if(!text)return;try{std::replace(text->begin(),text->end(),L',',L'.');size_t read=0;double bpm=std::stod(*text,&read);if(read!=text->size()||!std::isfinite(bpm)||bpm<MinTempo||bpm>MaxTempo)throw std::runtime_error("BPM must be a number from 10 to 999");setTempo(bpm);}catch(const std::exception&e){error(e.what());}}
