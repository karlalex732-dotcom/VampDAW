    void duplicateTrack(){if(sampleBusy){notify(L"Дождись окончания обработки аудио");return;}if(selected==MasterChannel)return;finishMidiRecording();finishAudioRecording();bool playing=engine.playing;engine.stop();engine.stopAudition();try{capturePluginStates();if(project.tracks.size()>=TrackCount)throw std::runtime_error("Maximum 512 tracks");history();int index=cloneTrack(project,selected);syncPlugins();select(index);changed();notify(L"Копия дорожки создана: паттерны, клипы, автоматизация и отдельные экземпляры VST.");}catch(const std::exception&e){error(e.what());}engine.start(desiredAudio);engine.playing=playing;}
    void moveSelectedTrack(int direction){++importGeneration;if(sampleBusy){notify(L"Дождись окончания обработки аудио");return;}if(selected==MasterChannel)return;int from=selected,to=selected+direction;if(to<0||to>=(int)project.tracks.size())return;finishMidiRecording();finishAudioRecording();bool playing=engine.playing;engine.stop();engine.stopAudition();capturePluginStates();history();reorderTrack(project,from,to);auto chain=std::move(plugins[from]);if(from<to)for(int i=from;i<to;i++)plugins[i]=std::move(plugins[i+1]);else for(int i=from;i>to;i--)plugins[i]=std::move(plugins[i-1]);plugins[to]=std::move(chain);for(auto&track:inputNoteTracks)track=-1;keyPitch.fill(-1);select(to);publish();engine.start(desiredAudio);engine.playing=playing;changed();notify(L"Порядок дорожек изменён. Шины и посылы следуют за дорожками.");}
    void commitClipGesture(){
        if(gestureClips.empty())return;
        try{
            if(playlistClipEdit!=PlaylistClipEdit::Move){
                auto item=gestureClips.front();int track=std::get<0>(item),index=std::get<1>(item);auto original=std::get<2>(item);auto c=playlistClipPreview(original);
                if(std::abs(c.beat-original.beat)<1e-9&&std::abs(c.length-original.length)<1e-9&&std::abs(c.fadeIn-original.fadeIn)<1e-7&&std::abs(c.fadeOut-original.fadeOut)<1e-7){gestureClips.clear();return;}
                if(c.warp&&!c.warpAudio){queuePlaylistWarp(track,index,c);}else{history();project.tracks[track].clips[index]=std::move(c);project.bars=std::max(project.bars,barsForEnd(project.tracks[track].clips[index].beat+project.tracks[track].clips[index].length));changed();}
            }else{
                if(std::abs(clipGestureDelta)<1e-9&&clipGestureTrackDelta==0&&!clipGestureCopy){gestureClips.clear();return;}
                for(auto&item:gestureClips){int from=std::get<0>(item),to=from+clipGestureTrackDelta;if(from!=to&&project.tracks[from].sample&&!project.tracks[from].sampler&&!plugins[to].empty()&&plugins[to][0]->instrument())throw std::runtime_error("Move audio onto an audio track; this destination has a VST instrument");}
                history();clipSelection=transformClips(project,clipSelection,clipGestureDelta,clipGestureTrackDelta,clipGestureCopy);if(!clipSelection.empty()){selected=clipSelection.begin()->first;selectedClip=clipSelection.begin()->second;liveTrack=selected;trackOffset=selected/8*8;noteSelection.clear();}changed();
            }
        }catch(const std::exception&e){error(e.what());}gestureClips.clear();playlistClipEdit=PlaylistClipEdit::None;
    }

    void stepContext(Hit h){if(frozenSource(h.index))return;if(h.index<0||h.index>=(int)project.tracks.size())return;select(h.index);HMENU menu=CreatePopupMenu();AppendMenuW(menu,MF_STRING,100,L"Высота и громкость шага…");AppendMenuW(menu,MF_SEPARATOR,0,nullptr);for(int every:{1,2,4,8})AppendMenuW(menu,MF_STRING,every,(L"Заполнить такт: каждый "+number(every)+L"-й шаг").c_str());AppendMenuW(menu,MF_STRING,16,L"Очистить этот такт");AppendMenuW(menu,MF_STRING,101,L"Сдвинуть такт на шаг влево");AppendMenuW(menu,MF_STRING,102,L"Сдвинуть такт на шаг вправо");POINT point;GetCursorPos(&point);int id=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);if(!id)return;auto&t=channel(selected);auto&notes=editNotes(t);double start=sequencerPage*4.;int pitch=t.sampler?t.rootNote:selected==2?36:selected==3?38:selected==4?42:60;float velocity=.75f;
        if(id==100){double beat=(h.extra-100)*.25;auto found=std::find_if(notes.begin(),notes.end(),[&](auto&n){return std::abs(n.beat-beat)<.02;});if(found!=notes.end()){pitch=found->pitch;velocity=found->velocity;}auto value=TextPrompt::show(window,L"Шаг: MIDI-нота 0–127, громкость 1–100",number(pitch)+L", "+number(velocity*100));if(!value)return;try{auto text=utf8(*value);std::replace(text.begin(),text.end(),',',' ');std::istringstream stream(text);double v=0;if(!(stream>>pitch>>v))throw std::runtime_error("Enter pitch, velocity");history();if(found==notes.end()){if(notes.size()>=100000)throw std::runtime_error("Maximum 100000 notes");notes.push_back({beat,.2,(int)clamp(pitch,0,127),(float)clamp(v/100,.01,1)});}else{found->pitch=(int)clamp(pitch,0,127);found->velocity=(float)clamp(v/100,.01,1);}}catch(const std::exception&e){error(e.what());return;}}
        else{history();if(id==101||id==102){for(auto&n:notes)if(n.beat>=start&&n.beat<start+4)n.beat=start+std::fmod(n.beat-start+(id==101?3.75:.25),4.);}else{notes.erase(std::remove_if(notes.begin(),notes.end(),[&](auto&n){return n.beat>=start&&n.beat<start+4;}),notes.end());if(id!=16){if(notes.size()+16>100000){notify(L"Максимум 100000 нот");return;}for(int step=0;step<16;step+=id)notes.push_back({start+step*.25,.2,pitch,velocity});}}}
        extendPattern(project,selected,t.activePattern,start+4);if(t.clips.empty())t.clips={{0,editLength(t),t.activePattern}};changed();
    }

    const wchar_t*metronomeName(int index)const{const wchar_t*names[]={L"1 · Classic / классический",L"2 · Digital / цифровой",L"3 · Woodblock / дерево",L"4 · Sticks / палочки",L"5 · Bell / колокольчик"};return names[(int)clamp(index,0,4)];}
    void metronomeButton(Painter&p,Rect r){bool enabled=engine.metronome;p.fill(r,enabled?alpha(crimson,45):raised,5);Color c=enabled?crimson:muted;float x=r.x+18,y=r.y+4;p.line(x,y,x-9,y+20,c,1.4f);p.line(x,y,x+9,y+20,c,1.4f);p.line(x-9,y+20,x+9,y+20,c,1.4f);p.line(x-6,y+16,x+6,y+16,c);float swing=motion&&engine.playing?(float)std::sin(engine.beat.load()*3.141592653589793)*7:5;p.line(x,y+17,x+swing,y+3,c,1.4f);p.fill({x+swing-2,y+4,4,5},c,1);addHit(ClickMenu,{r.x,r.y,r.w-14,r.h});p.text(L"▾",{r.x+r.w-16,r.y,14,r.h},10,muted,false,1);addHit(ClickMenu,{r.x+r.w-16,r.y,16,r.h},1);if(engine.countInRemaining>0)p.text(number(std::ceil(engine.countInRemaining.load())),{r.x+31,r.y,12,r.h},10,textColor,true,1);}

    void panelSplitters(Painter&p){auto splitter=[&](Rect r,int index,bool vertical){Color c=blend(panel,crimson,.18f);if(vertical){p.line(r.x+r.w/2,r.y,r.x+r.w/2,r.y+r.h,c);for(int i=-1;i<=1;i++)p.circle(r.x+r.w/2,r.y+r.h/2+i*6,1.2f,muted);}else{p.line(r.x,r.y+r.h/2,r.x+r.w,r.y+r.h/2,c);for(int i=-1;i<=1;i++)p.circle(r.x+r.w/2+i*6,r.y+r.h/2,1.2f,muted);}addHit(PanelSplitter,r,index);};if(leftPanelVisible)splitter({work.x-13,144,11,height-182},0,true);if(inspectorVisible)splitter({width-inspectorWidth-26,144,12,height-182},1,true);if(editorVisible&&mode==0&&maximizedPane<0){splitter({work.x,arrangement.y+arrangement.h+20,work.w,12},5,false);p.text(L"Playlist height ↕",{work.x+4,arrangement.y+arrangement.h+16,124,20},8,muted);}else if(editorVisible&&mixerDockVisible&&mode==2)splitter({work.x,height-mixerDockHeight-78,work.w,8},2,false);if(editorVisible&&automationVisible&&mode==0)splitter({arrangement.x,autoLane.y-43,arrangement.w,8},3,false);if(editorVisible&&mode==1&&selected!=MasterChannel)splitter({piano.x,velocity.y-44,piano.w,8},4,false);}
