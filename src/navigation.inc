    float dockHeight()const{return maximizedPane>=0||!mixerDockVisible||!editorVisible?0:mixerDockHeight;}
    void toggleMaximize(int pane){if(editGesture)mouseUp();if(pane<5||pane==7||pane==9)editorVisible=true;if(pane==5)leftPanelVisible=true;if(pane==6)inspectorVisible=true;if(maximizedPane==pane){maximizedPane=-1;if(maximizeRestoreMode>=0)mode=maximizeRestoreMode;maximizeRestoreMode=-1;}else{maximizeRestoreMode=(pane==3&&(mode==0||mode==2))?mode:-1;maximizedPane=pane;if((pane>=0&&pane<=4)||pane==7||pane==9)mode=pane;}canvasScrollX=canvasScrollY=0;InvalidateRect(window,nullptr,FALSE);}
    void navBar(Painter&p,Rect r,int id,double value,double total,double page,bool vertical=false){total=std::max(page,total);value=clamp(value,0,total-page);p.fill(r,raised,5);float length=vertical?r.h:r.w,thumb=std::max(24.f,length*(float)(page/total));thumb=std::min(thumb,length);float offset=total>page?(length-thumb)*(float)(value/(total-page)):0;Rect handle=vertical?Rect{r.x+2,r.y+offset, r.w-4,thumb}:Rect{r.x+offset,r.y+2,thumb,r.h-4};p.fill(handle,total>page?blend(muted,crimson,.35f):lineColor,4);navBars.push_back({r,id,value,total,page,vertical});addHit(NavScrollbar,r,(int)navBars.size()-1);}
    void setNavigation(int id,double value){switch(id){case 14:sequencerStepStart=clamp(value,0,std::max(0.,sequencerSteps()-sequencerVisibleSteps()));break;case 13:arrangerRoleOffset=(int)std::round(value);break;case 0:viewStart=value;break;case 1:trackOffset=(int)std::round(value);break;case 2:pianoStart=value;break;case 3:octave=128-pianoKeys-(int)std::round(value);break;case 4:sequencerPage=(int)clamp(std::round(value),0,64-sequencerBars);break;case 5:browserScroll=(int)std::round(value);break;case 6:slotOffset=(int)std::round(value);break;case 7:audioStart=value;break;case 11:playlistRowOffset=(int)std::round(value);break;case 12:projectTreeScroll=(int)std::round(value);break;case 10:automationStart=value;normalizeAutomationView();break;case 8:case 9:folderScroll[id-8]=(int)std::round(value);folderFocus=id-8;break;}normalizeView();InvalidateRect(window,nullptr,FALSE);}
    void navDrag(float x,float y){auto&r=activeNav.rail;float length=activeNav.vertical?r.h:r.w;float thumb=std::min(length,std::max(24.f,length*(float)(activeNav.page/activeNav.total)));double value=length>thumb?((activeNav.vertical?y-r.y:x-r.x)-navGrab)/(length-thumb)*(activeNav.total-activeNav.page):0;setNavigation(activeNav.id,clamp(value,0,activeNav.total-activeNav.page));}
    void beginNav(int index,float x,float y){if(index<0||index>=(int)navBars.size())return;activeNav=navBars[index];auto&r=activeNav.rail;float length=activeNav.vertical?r.h:r.w,thumb=std::min(length,std::max(24.f,length*(float)(activeNav.page/activeNav.total)));float offset=activeNav.total>activeNav.page?(length-thumb)*(float)(activeNav.value/(activeNav.total-activeNav.page)):0;float at=activeNav.vertical?y-r.y:x-r.x;navGrab=at>=offset&&at<=offset+thumb?at-offset:thumb/2;drag={NavScrollbar,r,0,80};editGesture=true;SetCapture(window);navDrag(x,y);}
    void navigationChrome(Painter&p){
        if(maximizedPane<0){
            if(leftPanelVisible){button(p,L"□",{work.x-65,146,22,22},MaximizePane,false,5);button(p,L"×",{work.x-40,146,22,22},ClosePane,false,5);}
            if(inspectorVisible){float x=width-69;button(p,L"□",{x,146,22,22},MaximizePane,false,6);button(p,L"×",{x+25,146,22,22},ClosePane,false,6);}
        }
        if(maximizedPane==5||maximizedPane==6){button(p,L"Restore · Enter",{width-210,112,150,26},MaximizePane,true,maximizedPane);button(p,L"×",{width-51,112,32,26},ClosePane,false,maximizedPane);return;}
        p.text(maximizedPane>=0?L"FOCUS VIEW  ·  Enter restores layout":L"WORKSPACE",{work.x,work.y-25,std::max(10.f,work.w-300),20},9,muted,true);
        if(editorVisible){button(p,L"Tools ▾",{work.x+work.w-270,work.y-26,99,22},WorkflowTools);button(p,maximizedPane>=0?L"Restore · Enter":L"Expand · Enter",{work.x+work.w-163,work.y-26,130,22},MaximizePane,maximizedPane>=0,maximizedPane>=0?maximizedPane:mode);button(p,L"×",{work.x+work.w-26,work.y-26,26,22},ClosePane,false,maximizedPane>=0?maximizedPane:mode);}
        if(!editorVisible&&maximizedPane<0)return;
        if(mode==7){navBar(p,{automationPlot.x,automationPlot.y+automationPlot.h+8,automationPlot.w,13},10,automationStart,std::max(project.bars*4.,automationSpan),automationSpan);return;}
        if(mode==0){navBar(p,{arrangement.x,arrangement.y+arrangement.h+3,arrangement.w,13},0,viewStart,std::max(project.bars*4.,visibleBars*4),visibleBars*4);navBar(p,{arrangement.x+arrangement.w+3,arrangement.y,13,arrangement.h},11,playlistRowOffset,playlistLayout.maxOffset()+std::max(1,playlistLayout.end(playlistRowOffset)-playlistRowOffset),std::max(1,playlistLayout.end(playlistRowOffset)-playlistRowOffset),true);if(automationVisible){button(p,L"□",{work.x+37,autoLane.y+24,24,22},MaximizePane,false,7);button(p,L"×",{work.x+65,autoLane.y+24,24,22},ClosePane,false,7);}}
        if(mode==1&&selected!=MasterChannel){navBar(p,{piano.x,piano.y+piano.h+3,piano.w,13},2,pianoStart,std::max(editLength(channel(selected)),pianoSpan),pianoSpan);navBar(p,{piano.x+piano.w+3,piano.y,13,piano.h},3,128-pianoKeys-octave,128,pianoKeys,true);}
        if(mode==2){auto grid=sequencerGrid();navBar(p,{grid.x,height-dockHeight()-112,grid.w,13},14,sequencerStepStart,sequencerSteps(),sequencerVisibleSteps());navBar(p,{work.x+work.w-14,grid.y,13,grid.h},1,trackOffset,project.tracks.size(),sequencerRows(),true);}
        if(mode==3)navBar(p,{work.x,height-50,work.w,13},1,trackOffset,project.tracks.size(),mixerPageTracks);
        if(mode==4&&!stemLabTab&&selected!=MasterChannel&&editingSample())navBar(p,{audioWave.x,audioWave.y+audioWave.h+3,audioWave.w,13},7,audioStart,editingSample()->left.size()/double(editingSample()->rate),audioSpan);
        if(maximizedPane<0&&mixerDockVisible&&(mode==0||mode==2)){button(p,L"□",{work.x+62,height-mixerDockHeight-73,24,20},MaximizePane,false,3);button(p,L"×",{work.x+89,height-mixerDockHeight-73,21,20},ClosePane,false,8);}
    }
    bool navigationKey(UINT key,bool control,bool alt){if(control)return false;bool horizontal=key==VK_LEFT||key==VK_RIGHT,vertical=key==VK_UP||key==VK_DOWN;if(!horizontal&&!vertical)return false;if(alt&&mode!=1)return false;if(!editorVisible&&navigationFocus==0)return false;if(mode==1&&navigationFocus==0&&!noteSelection.empty())return false;int direction=key==VK_LEFT||key==VK_UP?-1:1;
        if(navigationFocus==1){if(vertical)setNavigation(5,clamp(browserScroll+direction,0,std::max(0,(int)browserEntries.size()-browserVisibleRows)));return true;}if(navigationFocus==2){if(vertical)setNavigation(6,clamp(slotOffset+direction,0,12));return true;}
        if(mode==9){setNavigation(13,clamp(arrangerRoleOffset+direction,0,std::max(0,(int)project.tracks.size()-arrangerRoleRows)));return true;}if(mode==4&&stemLabTab)return true;if(mode==0&&vertical){setNavigation(11,clamp(playlistRowOffset+direction,0,playlistLayout.maxOffset()));return true;}if(mode==0||mode==2||mode==3){if(vertical||mode==3)setNavigation(1,clamp(trackOffset+direction,0,std::max(0,(int)project.tracks.size()-(mode==3?mixerPageTracks:mode==2?sequencerRows():8))));else if(mode==0)setNavigation(0,clamp(viewStart+direction*std::max(.25,visibleBars/4),0,std::max(0.,project.bars*4.-visibleBars*4)));else setNavigation(4,clamp(sequencerPage+direction,0,64-sequencerBars));}
        if(mode==1&&selected!=MasterChannel){if(vertical)setNavigation(3,clamp(128-pianoKeys-octave+direction*3,0,128-pianoKeys));else setNavigation(2,clamp(pianoStart+direction*pianoSpan*.1,0,std::max(0.,editLength(channel(selected))-pianoSpan)));}
        if(mode==4&&selected!=MasterChannel&&editingSample()){if(horizontal)setNavigation(7,clamp(audioStart+direction*audioSpan*.1,0,std::max(0.,editingSample()->left.size()/double(editingSample()->rate)-audioSpan)));}return true;
    }
