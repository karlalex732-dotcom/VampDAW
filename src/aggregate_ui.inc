    void refreshAggregateControls(){aggregateOutputs=audioPorts();aggregateInputs=audioPorts(true);auto combo=[&](int id,const std::vector<AudioPort>&ports,const std::wstring&selected,bool optional){SendDlgItemMessageW(aggregateWindow,id,CB_RESETCONTENT,0,0);SendDlgItemMessageW(aggregateWindow,id,CB_ADDSTRING,0,(LPARAM)(optional?L"Disabled":L"System default"));int select=0;for(int i=0;i<(int)ports.size();i++){SendDlgItemMessageW(aggregateWindow,id,CB_ADDSTRING,0,(LPARAM)ports[i].name.c_str());if(ports[i].id==selected)select=i+1;}SendDlgItemMessageW(aggregateWindow,id,CB_SETCURSEL,select,0);};combo(200,aggregateOutputs,desiredAudio,false);combo(201,aggregateInputs,desiredCapture,false);for(int i=0;i<3;i++){combo(210+i,aggregateOutputs,engine.aggregateOutputIds[i],true);combo(230+i,aggregateInputs,engine.aggregateInputIds[i],true);int id=220+i;SendDlgItemMessageW(aggregateWindow,id,CB_RESETCONTENT,0,0);SendDlgItemMessageW(aggregateWindow,id,CB_ADDSTRING,0,(LPARAM)L"Master");for(auto&t:project.tracks)SendDlgItemMessageW(aggregateWindow,id,CB_ADDSTRING,0,(LPARAM)wide(t.name).c_str());SendDlgItemMessageW(aggregateWindow,id,CB_SETCURSEL,engine.aggregateSources[i]==MasterChannel?0:engine.aggregateSources[i]+1,0);}SendDlgItemMessageW(aggregateWindow,202,BM_SETCHECK,engine.aggregateEnabled?BST_CHECKED:BST_UNCHECKED,0);SetDlgItemTextW(aggregateWindow,203,aggregateName.c_str());}
