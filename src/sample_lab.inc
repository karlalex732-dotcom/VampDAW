    bool sampleInput(float x,float y,bool right,bool twice){if(selected==MasterChannel||!editingSample()||!audioWave.contains(x,y))return false;auto&t=channel(selected);double time=clamp(audioStart+(x-audioWave.x)/audioWave.w*audioSpan,0,editingSample()->left.size()/double(editingSample()->rate));if(GetKeyState(VK_MENU)&0x8000){if(t.slices.empty())t.slices=sliceSample(*editingSample(),1);if(t.slices.size()>=32)return true;for(size_t i=0;i<t.slices.size();i++)if(time>t.slices[i].start+.001&&time<t.slices[i].end-.001){history();auto next=t.slices[i];next.start=time;t.slices[i].end=time;t.slices.insert(t.slices.begin()+i+1,next);changed();break;}return true;}if(twice){for(size_t i=0;i<t.slices.size();i++)if(time>=t.slices[i].start&&time<t.slices[i].end){activePad=(int)i;audioSelectA=t.slices[i].start;audioSelectB=t.slices[i].end;InvalidateRect(window,nullptr,FALSE);return true;}}if(right){audioToolsMenu();return true;}audioSelectA=audioSelectB=time;drag={None,audioWave,selected,30};editGesture=true;SetCapture(window);InvalidateRect(window,nullptr,FALSE);return true;}
    void commitAudio(std::shared_ptr<Sample>sample,bool resetSlices=false){
        if(!sample||selected==MasterChannel||!editingSample())return;auto&t=channel(selected);auto previous=editingSample();double before=previous->left.size()/double(previous->rate),after=sample->left.size()/double(sample->rate);if(sample->left.empty())throw std::runtime_error("Edit would leave an empty sample");
        auto file=root/L"projects/assets"/(L"Edit-"+number(GetTickCount64())+L"-"+number(++sampleGeneration)+L".wav");fs::create_directories(file.parent_path());WaveWriter writer(file,sample->rate);for(size_t i=0;i<sample->left.size();i+=MaxBlock)writer.write(sample->left.data()+i,sample->right.data()+i,(int)std::min<size_t>(MaxBlock,sample->left.size()-i));writer.finish();sample->path=file;history();double ratio=before>0?after/before:1;
        bool independent=!t.sampler&&editingClip()&&editingClip()->audio;int clipIndex=selectedClip<0?0:selectedClip;if(!independent)t.sample=sample;
        if(!t.sampler)for(int i=0;i<(int)t.clips.size();i++){auto&c=t.clips[i];if(independent?i!=clipIndex:c.audio!=nullptr)continue;if(independent)c.audio=sample;c.warp=false;c.warpPoints.clear();c.warpAudio.reset();c.warpReference.reset();c.offset=resetSlices?0:clamp(c.offset*ratio,0,std::max(0.,after-.001));c.length=std::max(.001,std::min(c.length*ratio,audioBeatLength(project,c.beat,after-c.offset)));project.bars=std::max(project.bars,barsForEnd(c.beat+c.length));}
        if(resetSlices)t.slices=t.sampler?sliceSample(*sample,1):std::vector<Slice>{};else for(auto&slice:t.slices){slice.start*=ratio;slice.end*=ratio;}if(t.sampleBpm>0)t.sampleBpm/=ratio;audioSelectA=audioSelectB=audioStart=0;audioSpan=after;audioAnalysisText.clear();changed();
    }
    void audioEditCommand(int command){if(frozenSource())return;if(selected==MasterChannel||!editingSample()||sampleBusy)return;auto source=editingSample();auto range=audioRange();size_t first=(size_t)(range.first*source->rate),last=std::min(source->left.size(),(size_t)std::llround(range.second*source->rate));try{if(command==20){audioSelectA=0;audioSelectB=source->left.size()/double(source->rate);InvalidateRect(window,nullptr,FALSE);return;}if(command==10||command==11){audioClipboard=extractSample(*source,first,last);if(command==10)commitAudio(editSample(*source,SampleEdit::Delete,first,last),true);return;}if(command==12||command==13){if(audioClipboard)commitAudio(pasteSample(*source,*audioClipboard,first,command==13),true);return;}if(command==21){audioSelectA=audioSelectB=0;InvalidateRect(window,nullptr,FALSE);return;}if(command>=1&&command<=9){SampleEdit action=command==1?SampleEdit::Trim:command==2?SampleEdit::Delete:command==3?SampleEdit::Silence:command==4?SampleEdit::Reverse:command==5?SampleEdit::Normalize:command==6?SampleEdit::FadeIn:command==7?SampleEdit::FadeOut:command==8?SampleEdit::RemoveDC:SampleEdit::Gain;double value=command==5?.98:1;if(command==9){auto text=TextPrompt::show(window,L"Усиление выделения, dB",L"0");if(!text)return;value=std::pow(10.,clamp(std::stod(*text),-60,24)/20.);}commitAudio(editSample(*source,action,first,last,value),command==1||command==2);}}catch(const std::exception&e){error(e.what());}}
    void audioToolsMenu(){HMENU menu=CreatePopupMenu();const wchar_t*names[]={L"Обрезать до выделения / Ctrl+Delete",L"Удалить / Delete",L"Заменить тишиной / Shift+Delete",L"Reverse",L"Normalize — −0.2 dB",L"Fade in",L"Fade out",L"Remove DC",L"Gain…",L"Вырезать / Ctrl+X",L"Копировать / Ctrl+C",L"Вставить / Ctrl+V",L"Вставить с заменой / Alt+V"};for(int i=0;i<13;i++)AppendMenuW(menu,MF_STRING,i+1,names[i]);AppendMenuW(menu,MF_SEPARATOR,0,nullptr);AppendMenuW(menu,MF_STRING,30,L"Свойства клипа: trim / length / gain / fades…");POINT point;GetCursorPos(&point);int id=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);if(id==30){if(editingClip())audioParameter(0);}else if(id>0)audioEditCommand(id);}
    void sliceMenu(){if(frozenSource())return;if(selected==MasterChannel||!editingSample()){importWav();return;}HMENU menu=CreatePopupMenu();AppendMenuW(menu,MF_STRING,100,L"Auto / transients — до 32 срезов");for(int count:{4,8,16,32})AppendMenuW(menu,MF_STRING,count,(L"Grid / "+number(count)+L" равных срезов").c_str());AppendMenuW(menu,MF_SEPARATOR,0,nullptr);AppendMenuW(menu,MF_STRING,101,channel(selected).sampler?L"Режим аудиоклипа":L"Включить MIDI Sampler");AppendMenuW(menu,MF_STRING,102,channel(selected).oneShot?L"One-shot → Gate":L"Gate → One-shot");POINT point;GetCursorPos(&point);int id=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);if(!id)return;auto&t=channel(selected);history();if(id<=32||id==100){t.slices=sliceSample(*editingSample(),id==100?32:id,id==100);t.chromatic=false;t.rootNote=36;activePad=0;}else if(id==101){auto source=editingSample();t.sampler=!t.sampler;if(t.sampler){t.audioInput=false;t.armed=false;t.monitor=false;t.sample=source;}if(t.sampler){if(t.slices.empty())t.slices=sliceSample(*editingSample(),16);t.notes.clear();t.patterns.clear();t.activePattern=0;t.clips.clear();}}else if(id==102)t.oneShot=!t.oneShot;changed();}
    void playPad(int index){if(selected==MasterChannel)return;auto&t=channel(selected);if(!editingSample()||index<0||index>=(int)t.slices.size())return;activePad=index;auto&s=t.slices[index];audioSelectA=s.start;audioSelectB=s.end;if(t.sampler){auditionPitch=t.rootNote+index;auditionTrack=selected;midi(0x90|(auditionPitch<<8)|(110<<16));}else previewSound(editingSample(),s.start,s.end);InvalidateRect(window,nullptr,FALSE);}
    void padMenu(int pad){if(frozenSource())return;if(selected==MasterChannel||pad>=(int)channel(selected).slices.size())return;activePad=pad;HMENU menu=CreatePopupMenu();AppendMenuW(menu,MF_STRING,1,L"Границы = выделение");AppendMenuW(menu,MF_STRING,2,L"Pitch, полутона…");AppendMenuW(menu,MF_STRING,3,L"Gain, dB…");AppendMenuW(menu,MF_STRING,4,L"Reverse / вперёд");POINT point;GetCursorPos(&point);int id=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);if(!id)return;auto&slice=channel(selected).slices[pad];if(id==1){auto range=audioRange();history();slice.start=range.first;slice.end=range.second;}else if(id==4){history();slice.reverse=!slice.reverse;}else{auto text=TextPrompt::show(window,id==2?L"Pitch среза, полутона":L"Gain среза, dB",number(id==2?slice.semitones:20*std::log10(std::max(.0001f,slice.gain)),2));if(!text)return;try{double value=std::stod(*text);history();if(id==2)slice.semitones=(float)clamp(value,-48,48);else slice.gain=(float)std::pow(10.,clamp(value,-60,12)/20);}catch(...){return;}}changed();}
    void sampleToPattern(){if(frozenSource())return;if(selected==MasterChannel||!editingSample())return;auto&t=channel(selected);if(t.slices.empty()){history();t.slices=sliceSample(*editingSample(),16);}else history();auto source=editingSample();t.sample=source;t.audioInput=false;t.armed=false;t.monitor=false;t.sampler=true;t.notes.clear();t.patterns.clear();t.activePattern=0;t.patternLength=4;for(size_t i=0;i<t.slices.size();i++){double beat=t.slices[i].start*project.bpm/60.;if(beat>=256)break;t.notes.push_back({beat,std::max(.01,(t.slices[i].end-t.slices[i].start)*project.bpm/60.),t.rootNote+(int)i,.9f});t.patternLength=std::min(256.,std::max(4.,std::ceil((beat+t.notes.back().length)/4)*4));}t.clips={{0,t.patternLength}};project.bars=std::max(project.bars,barsForEnd(t.patternLength));mode=1;octave=t.rootNote;pianoStart=0;pianoSpan=std::min(16.,t.patternLength);changed();}
    void analyzeAudio(){if(selected==MasterChannel||!editingSample())return;auto&t=channel(selected);auto result=analyzeSample(*editingSample());history();t.sampleBpm=result.bpm;t.sampleKey=result.key;audioAnalysisText="Estimate: "+(result.bpm>0?std::to_string((int)result.bpm)+" BPM":"tempo unclear")+" / "+result.key+" (key confidence "+std::to_string((int)(result.keyConfidence*100))+"%)";changed();}
    void startSampleWork(std::function<std::shared_ptr<Sample>(const Sample&)>operation){if(frozenSource())return;if(sampleBusy||selected==MasterChannel||!editingSample())return;if(sampleWorker.joinable())sampleWorker.join();sampleBusy=1;sampleDone=false;sampleError.clear();sampleResult.reset();sampleTarget=selected;sampleWorkSource=editingSample();sampleTargetClip=selectedClip;auto source=sampleWorkSource;sampleWorker=std::thread([this,source,operation]{try{sampleResult=operation(*source);}catch(const std::exception&e){sampleError=e.what();}sampleDone=true;});notify(L"Обработка аудио в фоне…");}
    void finishSampleWork(){if(!sampleBusy||!sampleDone)return;if(sampleWorker.joinable())sampleWorker.join();sampleBusy=0;if(!sampleError.empty()){error(sampleError);return;}int oldSelected=selected,oldClip=selectedClip;selected=sampleTarget;selectedClip=sampleTargetClip;if(sampleTarget<0||sampleTarget>=(int)project.tracks.size()||editingSample()!=sampleWorkSource){selected=oldSelected;selectedClip=oldClip;notify(L"Дорожка изменилась во время обработки — результат не применён");return;}try{commitAudio(sampleResult,false);}catch(const std::exception&e){error(e.what());}selected=oldSelected;selectedClip=oldClip;sampleResult.reset();sampleWorkSource.reset();notify(L"Аудио обработано. Ctrl+Z — отменить.");}
    void processAudioPitch(){auto text=TextPrompt::show(window,L"Pitch без изменения длины, полутона (−24…24)",L"0");if(!text)return;try{double semitones=clamp(std::stod(*text),-24,24);startSampleWork([semitones](const Sample&s){return pitchSample(s,semitones);});}catch(...){}}
    void processAudioStretch(){if(selected==MasterChannel||!editingSample())return;HMENU menu=CreatePopupMenu();AppendMenuW(menu,MF_STRING,1,L"Длительность в % без изменения высоты…");AppendMenuW(menu,MF_STRING,2,L"Подогнать к темпу проекта (после Analyze)");POINT point;GetCursorPos(&point);int id=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);double ratio=1;if(id==1){auto text=TextPrompt::show(window,L"Длительность, % (25…400)",L"100");if(!text)return;try{ratio=clamp(std::stod(*text)/100,.25,4);}catch(...){return;}}else if(id==2){if(channel(selected).sampleBpm<=0){notify(L"Сначала выполни Analyze или укажи темп");return;}ratio=clamp(channel(selected).sampleBpm/project.bpm,.25,4);}else return;startSampleWork([ratio](const Sample&s){return stretchSample(s,ratio);});}
    void exportSample(){if(selected==MasterChannel||!editingSample())return;auto path=fileDialog(true,L"WAV 24 bit (*.wav)\0*.wav\0\0",L"wav",root/L"renders"/L"Sample.wav");if(path.empty())return;try{auto range=audioRange();auto&s=*editingSample();size_t first=(size_t)(range.first*s.rate),last=std::min(s.left.size(),(size_t)std::llround(range.second*s.rate));WaveWriter writer(path,s.rate);for(size_t i=first;i<last;i+=MaxBlock)writer.write(s.left.data()+i,s.right.data()+i,(int)std::min<size_t>(MaxBlock,last-i));writer.finish();notify(L"Выделение сохранено в WAV 24 bit");}catch(const std::exception&e){error(e.what());}}
