        for(size_t i=0;i<t.slices.size();i++){float xx=audioWave.x+(float)((t.slices[i].start-audioStart)/audioSpan)*audioWave.w;p.line(xx,audioWave.y,xx,audioWave.y+audioWave.h,activePad==(int)i?textColor:colors[i%5],1.5f);p.text(number(i+1),{xx+4,audioWave.y+3,24,16},9,colors[i%5],true);}p.g.Restore(state);
