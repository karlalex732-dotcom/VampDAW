    bool editPlaylistMarker(int index,const Marker&value){if(index<0||index>=(int)project.markers.size()||!validPlaylistMarker(project,value))return false;auto&old=project.markers[index];if(old.beat==value.beat&&old.name==value.name&&old.color==value.color)return true;history();selectedMarker=updatePlaylistMarker(project,index,value);markerGeneration=importGeneration;markerChanged();return true;}
