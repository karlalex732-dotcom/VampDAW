    void positionPlaylistMarker(){if(!hasSelectedMarker())return;int index=selectedMarker;auto marker=project.markers[index];int bar=(int)std::floor(marker.beat/4)+1;auto value=TextPrompt::show(window,L"Marker position / bar:beat (e.g. 9:1 or 9:2.5)",number(bar)+L":"+number(std::fmod(marker.beat,4.)+1,2));if(!value)return;
