    void playlistMarkerCommand(int command){if(!hasSelectedMarker())return;if(command==1)renamePlaylistMarker();else if(command==2)positionPlaylistMarker();else if(command==3)removePlaylistMarker();else if(command>=10&&command<15){auto marker=project.markers[selectedMarker];marker.color=command-10;editPlaylistMarker(selectedMarker,marker);}}
    void playlistMarkerMenu(){HMENU menu=CreatePopupMenu();auto item=[&](UINT id,const wchar_t*label){auto text=ui::translate(label);AppendMenuW(menu,MF_STRING,id,text.c_str());};item(1,L"Rename marker… / F2");item(2,L"Set marker position…");HMENU palette=CreatePopupMenu();const wchar_t*names[]={L"Crimson",L"Amethyst",L"Antique gold",L"Midnight jade",L"Moonlight"};for(int i=0;i<5;i++){auto name=ui::translate(names[i]);AppendMenuW(palette,MF_STRING|(project.markers[selectedMarker].color==i?MF_CHECKED:0),10+i,name.c_str());}auto color=ui::translate(L"Marker color");AppendMenuW(menu,MF_POPUP,(UINT_PTR)palette,color.c_str());AppendMenuW(menu,MF_SEPARATOR,0,nullptr);item(3,L"Delete marker / Delete");POINT point{};GetCursorPos(&point);int command=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);playlistMarkerCommand(command);}
    bool playlistMarkerClick(float x,float y,bool right,bool twice){if(settingsOpen||exportBusy||exportSettingsOpen||openMenu>=0||!editorVisible||mode!=0)return false;for(auto hit=hits.rbegin();hit!=hits.rend();++hit)if(hit->rect.contains(x,y)){if(hit->action!=PlaylistMarker)return false;if(audioRecording){notify(L"Stop audio recording before editing markers");return true;}if(hit->index<0||hit->index>=(int)project.markers.size())return true;selectPlaylistMarker(hit->index);if(right){playlistMarkerMenu();return true;}if(twice){renamePlaylistMarker();return true;}markerDragBeat=project.markers[selectedMarker].beat;markerDragViewStart=viewStart;markerDragChanged=false;dragStartX=x;gestureX=x;gestureY=y;selectionScrollTime=GetTickCount64();drag={PlaylistMarker,arrangement,selectedMarker,45};editGesture=true;SetCapture(window);return true;}return false;}
    void dragPlaylistMarker(float x){if(!hasSelectedMarker()||(std::abs(x-dragStartX)<3&&!markerDragChanged))return;double beat=clamp(markerDragBeat+viewStart-markerDragViewStart+(x-dragStartX)/arrangement.w*visibleBars*4,0,project.bars*4.);beat=clamp(quantize(beat),0,project.bars*4.);auto&marker=project.markers[selectedMarker];if(marker.beat==beat)return;if(!markerDragChanged){history();markerDragChanged=true;}marker.beat=beat;markerChanged();}
    void finishPlaylistMarkerDrag(){if(hasSelectedMarker()&&markerDragChanged)selectedMarker=sortPlaylistMarkers(project,selectedMarker);markerDragChanged=false;}
    bool playlistMarkerKey(UINT key,bool control,bool alt){if(mode!=0||!editorVisible||!hasSelectedMarker()||control||alt||audioRecording)return false;if(key==VK_ESCAPE){if(editGesture)return false;selectedMarker=-1;InvalidateRect(window,nullptr,FALSE);return true;}if(key==VK_DELETE){removePlaylistMarker();return true;}if(key==VK_F2){renamePlaylistMarker();return true;}if((key==VK_LEFT||key==VK_RIGHT)&&!typingPiano){auto marker=project.markers[selectedMarker];double step=(GetKeyState(VK_SHIFT)&0x8000)?4:std::max(.0625,snapStep);marker.beat=clamp(marker.beat+(key==VK_LEFT?-step:step),0,project.bars*4.);editPlaylistMarker(selectedMarker,marker);return true;}return false;}
    void drawPlaylistMarkers(Painter&p,float timeline,float unit){
        auto state=p.g.Save();p.g.SetClip(Rect{arrangement.x,timeline-49,arrangement.w,arrangement.h+49}.f(),CombineModeIntersect);
        for(int index=0;index<(int)project.markers.size();index++){auto&m=project.markers[index];float x=arrangement.x+(float)(m.beat-viewStart)*unit;if(x<arrangement.x||x>arrangement.x+arrangement.w)continue;auto color=colors[std::clamp(m.color,0,4)];bool selected=hasSelectedMarker()&&selectedMarker==index;p.line(x,timeline,x,timeline+arrangement.h,alpha(color,selected?160:80),selected?1.5f:1);
            double nextBeat=viewStart+visibleBars*4;int group=0,rank=0;for(int other=0;other<(int)project.markers.size();other++){auto&marker=project.markers[other];if(marker.beat>m.beat)nextBeat=std::min(nextBeat,marker.beat);if(marker.beat==m.beat){group++;if(other<index)rank++;}}
            float width=std::max(0.f,std::min({126.f,(float)((nextBeat-m.beat)*unit)-2,arrangement.x+arrangement.w-x}))/std::max(1,group);if(width<3)continue;x+=rank*width;Rect flag{x,timeline-48,std::max(1.f,width-1),19};p.fill(flag,alpha(color,selected?85:27),3);p.fill({x,timeline-48,std::min(3.f,flag.w),19},color,1);if(width>=27)p.text(wide(m.name),{x+6,timeline-48,width-8,19},9,selected?textColor:color,true,0,false);if(selected)p.line(x,timeline-29,x+flag.w,timeline-29,color,1.5f);if(width>=5)addHit(PlaylistMarker,flag,index);
