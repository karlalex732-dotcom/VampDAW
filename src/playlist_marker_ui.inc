    int selectedMarker=-1;uint64_t markerGeneration=UINT64_MAX;double markerDragBeat=0,markerDragViewStart=0;bool markerDragChanged=false;
    bool hasSelectedMarker()const{return markerGeneration==importGeneration&&selectedMarker>=0&&selectedMarker<(int)project.markers.size();}
