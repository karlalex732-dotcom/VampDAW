    float pianoEditorHeight=0,sequencerEditorWidth=0,pianoKeyHeight=0;
    float pianoAvailableHeight()const{return std::max(1.f,height-work.y-34);}
    float pianoLaneHeight()const{return (float)clamp(velocityHeight,50,std::max(50.f,std::min(220.f,work.h-371)));}
    float pianoGridHeight()const{return std::max(140.f,work.h-231-pianoLaneHeight());}
    void sizeEditorWork(){if(!editorVisible||maximizedPane==5||maximizedPane==6)return;if(mode==1&&pianoEditorHeight>0)work.h=(float)clamp(pianoEditorHeight,std::min(450.f,work.h),work.h);if(mode==2&&sequencerEditorWidth>0)work.w=(float)clamp(sequencerEditorWidth,std::min(500.f,work.w),work.w);}
    void setPianoOctaves(int octaves){octaves=(int)clamp(octaves,2,5);velocityHeight=std::min(velocityHeight,std::max(50.f,pianoAvailableHeight()-231-octaves*12*4));float needed=octaves*12*4.f+231+velocityHeight;if(work.h<needed){pianoEditorHeight=std::min(pianoAvailableHeight(),needed);work.h=pianoEditorHeight;}pianoKeyHeight=(float)clamp(pianoGridHeight()/(octaves*12),4,36);pianoKeys=(int)clamp(std::floor(pianoGridHeight()/pianoKeyHeight+.001f),12,96);octave=(int)clamp(octave,0,128-pianoKeys);saveSettings();InvalidateRect(window,nullptr,FALSE);}
    void pianoOctavesMenu(){HMENU menu=CreatePopupMenu();for(int n:{2,3,4,5})AppendMenuW(menu,MF_STRING|(pianoKeys==n*12?MF_CHECKED:0),n,(L"Octaves: "+number(n)).c_str());POINT point;GetCursorPos(&point);int choice=TrackPopupMenu(menu,TPM_RETURNCMD,point.x,point.y,0,window,nullptr);DestroyMenu(menu);if(choice)setPianoOctaves(choice);}
    void editorResizeChrome(Painter&p){if(!editorVisible||settingsOpen||exportSettingsOpen||maximizedPane==5||maximizedPane==6)return;if(mode==1&&selected!=MasterChannel){Rect r{work.x,work.y+work.h-5,work.w,8};p.line(r.x,r.y+4,r.x+r.w,r.y+4,lineColor);for(int n=-1;n<=1;n++)p.circle(r.x+r.w/2+n*7,r.y+4,1.2f,muted);addHit(EditorResize,r,1);}if(mode==2){Rect r{work.x+work.w+3,work.y,9,work.h};p.line(r.x+4,r.y,r.x+4,r.y+r.h,lineColor);for(int n=-1;n<=1;n++)p.circle(r.x+4,r.y+r.h/2+n*7,1.2f,muted);addHit(EditorResize,r,2);}}
    void beginEditorResize(Hit h,float x,float y,bool reset){if(reset){if(h.index==1)pianoEditorHeight=0;else sequencerEditorWidth=0;saveSettings();InvalidateRect(window,nullptr,FALSE);return;}if(h.index==1&&pianoKeyHeight<=0)pianoKeyHeight=(float)clamp(pianoRow,4,36);drag=h;oldValue=h.index==1?work.h:work.w;dragStartX=x;dragStartY=y;editGesture=true;SetCapture(window);}
    void resizeEditor(float x,float y){if(drag.index==1)pianoEditorHeight=(float)clamp(oldValue+y-dragStartY,std::min(450.f,pianoAvailableHeight()),pianoAvailableHeight());else{float left=leftPanelVisible?(browserVisible?browserWidth:std::min(browserWidth,196.f)):4,right=inspectorVisible?inspectorWidth:0,maximum=maximizedPane>=0?width-52:width-left-right-60;sequencerEditorWidth=(float)clamp(oldValue+x-dragStartX,std::min(500.f,maximum),maximum);}InvalidateRect(window,nullptr,FALSE);}
