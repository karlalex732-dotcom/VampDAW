if(argc>3&&std::wstring(argv[1])==L"--project-audio-check"){
    Json report={{"passed",false}};try{auto p=loadProject(argv[2]);auto plan=compile(p);auto missing=missingProjectMedia(p);Json refs=Json::array();for(auto&m:missing)refs.push_back({{"track",m.owner},{"path",utf8(m.sample->path.wstring())},{"error",m.sample->loadError}});int notes=0,samples=0;for(auto&t:p.tracks){notes+=(int)t.notes.size();for(auto&pattern:t.patterns)notes+=(int)pattern.notes.size();samples+=t.sample&&!t.sample->missing;}report.update({{"passed",true},{"tracks",p.tracks.size()},{"notes",notes},{"events",plan->events.size()},{"available_track_samples",samples},{"missing_audio",refs},{"version",8}});}catch(const std::exception&e){report["error"]=e.what();}std::ofstream(fs::path(argv[3]))<<report.dump(2);LocalFree(argv);CoUninitialize();return report["passed"]==true?0:1;
